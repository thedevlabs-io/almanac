# Everything here is excluded from the packaged .vsix (vsce reads this file,
# not .gitignore). A consumer only needs dist/, media/, README, LICENSE,
# package.json and the changelog — keep internal docs and dev config out.

.claude/
.vscode/
docs/
AGENTS.md
CLAUDE.md
